{
	"info": {
		"_postman_id": "prokratura-backend-api",
		"name": "Prokratura Backend API",
		"description": "API collection for Prokratura oversight of Mahallas and Mahalla Yettiligi",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
