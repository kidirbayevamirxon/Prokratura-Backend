# PostgreSQL Database Configuration
POSTGRES_USER=prokratura
POSTGRES_PASSWORD=prokratura_pass
POSTGRES_DB=prokratura
POSTGRES_PORT=5439

# Database URLs
DB_URL=postgresql://prokratura:prokratura_pass@prokratura-postgres:5432/prokratura
ASYNC_DB_URL=postgresql+asyncpg://prokratura:prokratura_pass@prokratura-postgres:5432/prokratura

# JWT Secrets (Generate secure random hex for production)
ACCESS_SECRET=your_super_secret_access_key_change_in_production
REFRESH_SECRET=your_super_secret_refresh_key_change_in_production

# Initial Super Admin (Seeded automatically on first boot)
FIRST_ADMIN_LOGIN=admin
FIRST_ADMIN_PHONE=+998900000000
FIRST_ADMIN_PASSWORD=AdminPass123!
